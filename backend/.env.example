# Core App Configuration
SECRET_KEY=your-django-secret-key-here
DEBUG=False
DATABASE_URL=postgres://user:password@localhost:5432/ticketsphere

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ticket-sphere-dusky.vercel.app

# Seat Hold TTL Configuration (in minutes)
HOLD_TTL_MINUTES=10

# Email Delivery Configuration
# Brevo (Sendinblue) API key for real-time ticket email dispatch
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
DEFAULT_FROM_EMAIL=ticketsphere.app@gmail.com

# Frontend API URL (Used in frontend/.env)
VITE_API_BASE_URL=http://localhost:8005/api
