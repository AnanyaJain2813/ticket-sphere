# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (leave blank to use SQLite locally)
DATABASE_URL=

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (optional — leave blank to see emails in console logs)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=tickets@cinestream.in

# Seat hold TTL in minutes
HOLD_TTL_MINUTES=10
