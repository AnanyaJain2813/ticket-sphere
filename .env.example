# ==============================
# Environment Configuration
# ==============================

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-this-secret-key-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Settings (Used in Production via DATABASE_URL; Local Dev defaults to SQLite if unconfigured)
# DATABASE_URL=postgresql://postgres:postgres_password@127.0.0.1:5432/ticket_booking_db
POSTGRES_DB=ticket_booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis & Celery Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api
